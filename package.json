{
  "name": "@tesourofieis/expo",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "main": "./index",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "start": "EXPO_UNSTABLE_ATLAS=1 expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "APP_VARIANT=development expo prebuild --platform android --clean && APP_VARIANT=development expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web && node scripts/prune-sourcemaps.mjs",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "format": "oxfmt --write .",
    "prebuild": "bunx tsx ./scripts/build-search-index.ts && bunx tsx ./scripts/generate-sitemap.ts",
    "prepare": "effect-language-service patch",
    "dev": "bun run prebuild && expo start --clear",
    "deploy": "for i in 1 2 3; do NODE_OPTIONS=--dns-result-order=ipv4first mise x -- eas build --platform all --auto-submit --profile production --non-interactive --no-wait && exit 0; [ $i -lt 3 ] && echo \"deploy attempt $i failed, retrying...\"; sleep 30; done; exit 1",
    "update": "for i in 1 2 3; do NODE_OPTIONS=--dns-result-order=ipv4first mise x -- eas update --auto --environment production && exit 0; [ $i -lt 3 ] && echo \"update attempt $i failed, retrying...\"; sleep 30; done; exit 1",
    "test": "bun test lib",
    "ci": "bun run lint && bun run check && bun run test",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check:unused": "knip",
    "cf:dev": "alchemy dev",
    "cf:deploy": "alchemy deploy",
    "cf:deploy:prod": "alchemy deploy --stage prod",
    "cf:destroy": "alchemy destroy"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@marceloterreiro/flash-calendar": "^2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tailwindcss/postcss": "^4.1.16",
    "date-fns": "^3.6.0",
    "effect": "^4.0.0-rc.111",
    "expo": "^57.0.0",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-insights": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "glob": "^11.0.3",
    "lucide-react-native": "^0.562.0",
    "minisearch": "^7.2.0",
    "nativewind": "5.0.0-preview.2",
    "postcss": "^8.5.6",
    "posthog-react-native": "^4.17.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/platform-bun": "^4.0.0-rc.111",
    "@effect/platform-node": "^4.0.0-rc.111",
    "@expo/metro-runtime": "~57.0.16",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.57.0",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.19.3",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "alchemy": "2.0.0-beta.80",
    "expo-atlas": "^0.4.3",
    "knip": "6.32.2",
    "oxfmt": "^0.41.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "bun@1.3.14"
}
